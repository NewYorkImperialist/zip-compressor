{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and quick-mode windows",
  "windows": [
    "main",
    "quick"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
